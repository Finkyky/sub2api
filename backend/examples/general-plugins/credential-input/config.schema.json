{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "credential-input config v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
          },
          "pattern": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
