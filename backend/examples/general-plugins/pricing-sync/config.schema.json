{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pricing-sync config v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "config_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 512
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "pricing_id",
          "source_key",
          "field",
          "multiplier",
          "max_price",
          "max_change_ratio"
        ],
        "properties": {
          "channel_id": {
            "type": "integer",
            "minimum": 1
          },
          "pricing_id": {
            "type": "integer",
            "minimum": 1
          },
          "source_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,127}$"
          },
          "field": {
            "type": "string",
            "enum": [
              "input_price",
              "output_price",
              "cache_write_price",
              "cache_read_price",
              "per_request_price"
            ]
          },
          "multiplier": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "max_price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000000
          },
          "max_change_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    }
  }
}
